  object.isCompleted = reader.readBool(offsets[1]);
  object.isFavorite = reader.readBool(offsets[2]);
  object.jsonData = reader.readString(offsets[3]);
  object.recipeId = reader.readString(offsets[4]);
  object.recipeTypeValue = reader.readString(offsets[5]);
  object.title = reader.readString(offsets[6]);
