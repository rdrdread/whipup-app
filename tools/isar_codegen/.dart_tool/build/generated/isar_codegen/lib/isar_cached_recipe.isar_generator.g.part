  bytesCount += 3 + object.recipeTypeValue.length * 3;
  bytesCount += 3 + object.title.length * 3;
  return bytesCount;
}

void _isarCachedRecipeSerialize(
  IsarCachedRecipe object,
  IsarWriter writer,
  List<int> offsets,
  Map<Type, List<int>> allOffsets,
) {
  writer.writeDateTime(offsets[0], object.cachedAt);
  writer.writeBool(offsets[1], object.isCompleted);
  writer.writeBool(offsets[2], object.isFavorite);
  writer.writeString(offsets[3], object.jsonData);
  writer.writeString(offsets[4], object.recipeId);
  writer.writeString(offsets[5], object.recipeTypeValue);
  writer.writeString(offsets[6], object.title);
}

IsarCachedRecipe _isarCachedRecipeDeserialize(
  Id id,
  IsarReader reader,
  List<int> offsets,
  Map<Type, List<int>> allOffsets,
) {
  final object = IsarCachedRecipe();
